# Copy this file to ".env" and fill in your values.
# ".env" is in .gitignore and must never be committed.

# Which LLM answers questions: "anthropic" (Claude API), "gemini" (Google Gemini API) or "ollama" (free, local backup)
LLM_PROVIDER=anthropic

# Claude API  (get a key at https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# How hard Claude thinks before answering: low (fast, fine for short Q&A), medium, high
CLAUDE_EFFORT=low

# Gemini API  (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Seconds to wait for Gemini to send something before giving up on a request (busy or stuck server).
# Also the longest pause allowed once the answer is being written. Gemini needs at least 10
# (a shorter server deadline is rejected), so values under 10 are raised to 10 for the request.
GEMINI_TIMEOUT_SECONDS=15
# Seconds a question waits for Gemini's first text (retries included) before Groq answers instead.
GEMINI_MAX_WAIT_SECONDS=5

# Groq backup: answers when Gemini is busy, times out or fails (https://console.groq.com/keys).
# After 2 Gemini failures in a row, Groq answers directly and Gemini is tried again every 5 questions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds per question for the whole AI answer (Gemini first, then Groq with the time left).
# If both fail, the matching passages are shown.
AI_BUDGET_SECONDS=10

# How pages are read: "local" (default) or "gemini"
#   local:  text and tables from the file itself; scanned pages and images are read with local OCR.
#   gemini: every PDF page / image is rendered at 200 dpi and only the IMAGE is sent to Gemini
#           (uses GEMINI_MODEL and GEMINI_API_KEY). Word, Excel, PowerPoint and text files stay local.
# PARSER=gemini sends page images to Google - only for non-company documents unless approved.
PARSER=local
# Local OCR speed (PARSER=local): scanned pages read at the same time (worker processes; 1 = off).
# 6 was as fast as 11 on a 10-core laptop and leaves the laptop usable while uploading.
OCR_WORKERS=6
# Page image resolution for OCR. 150 lost accuracy (eval 13/15), 300 was not faster or better.
OCR_DPI=200

# Ollama backup (only used when LLM_PROVIDER=ollama). Example: llama3.2:3b
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Re-ranker: re-orders the best RERANK_CANDIDATES passages by how well they answer the question.
# Set RERANK_MODEL=none to switch it off.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=20
CHROMA_DIR=storage/chroma
UPLOAD_DIR=data/uploads
# Number of passages retrieved per question
TOP_K=5
# If the best passage scores below this (0-1), answer "I could not find this" without calling the LLM
MIN_SCORE=0.55
# Exact-value answers: a question this similar (0-1) to a stored value name or Q&A question is
# answered straight from the document line, without the LLM
FACT_MATCH_SCORE=0.80
CHUNK_SIZE=800
CHUNK_OVERLAP=150
