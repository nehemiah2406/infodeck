# Copy this file to ".env" and fill in your values.
# ".env" is in .gitignore and must never be committed.

# Which LLM answers questions: "anthropic" (Claude API), "gemini" (Google Gemini API) or "ollama" (free, local backup)
LLM_PROVIDER=anthropic

# Claude API  (get a key at https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# How hard Claude thinks before answering: low (fast, fine for short Q&A), medium, high
CLAUDE_EFFORT=low

# Gemini API  (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama backup (only used when LLM_PROVIDER=ollama). Example: llama3.2:3b
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Re-ranker: re-orders the best RERANK_CANDIDATES passages by how well they answer the question.
# Set RERANK_MODEL=none to switch it off.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=20
CHROMA_DIR=storage/chroma
UPLOAD_DIR=data/uploads
# Number of passages retrieved per question
TOP_K=5
# If the best passage scores below this (0-1), answer "I could not find this" without calling the LLM
MIN_SCORE=0.55
CHUNK_SIZE=800
CHUNK_OVERLAP=150
