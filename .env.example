# Copy this file to ".env" and fill in your values.
# ".env" is in .gitignore and must never be committed.

# Which LLM answers questions: "anthropic" (Claude API) or "ollama" (free, local backup)
LLM_PROVIDER=anthropic

# Claude API  (get a key at https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Ollama backup (only used when LLM_PROVIDER=ollama). Example: llama3.2:3b
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=storage/chroma
TOP_K=4
